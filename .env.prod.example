# Copiar para .env.prod e preencher. NUNCA fazer commit do .env.prod.

# ---- Domínio (definir o mesmo host na UI do Nginx Proxy Manager:
#      Proxy Host -> forward para  txuvukka-web : 3000) ----
DOMAIN=txuvukka.konekto.co.mz

# ---- Rede externa do Docker onde vive o Nginx Proxy Manager ----
# Confirmar com:
#   docker inspect nginx-proxy-manager-npm-1 -f '{{range $k,$_ := .NetworkSettings.Networks}}{{$k}} {{end}}'
NPM_NETWORK=nginx-proxy-manager_default
